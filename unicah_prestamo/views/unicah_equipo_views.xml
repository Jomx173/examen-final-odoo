<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="unicah_equipo_view_list" model="ir.ui.view">
        <field name="name">unicah.equipo.list</field>
        <field name="model">unicah.equipo</field>
        <field name="arch" type="xml">
            <list>
                <field name="codigo"/>
                <field name="name"/>
                <field name="tipo"/>
                <field name="ubicacion"/>
            </list>
        </field>
    </record>

    <record id="unicah_equipo_view_form" model="ir.ui.view">
        <field name="name">unicah.equipo.form</field>
        <field name="model">unicah.equipo</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="codigo"/>
                            <field name="tipo"/>
                        </group>
                        <group>
                            <field name="ubicacion"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="unicah_equipo_action" model="ir.actions.act_window">
        <field name="name">Equipos</field>
        <field name="res_model">unicah.equipo</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="unicah_prestamo_root_menu" model="ir.ui.menu">
        <field name="name">Préstamos UNICAH</field>
        <field name="sequence">5</field>
    </record>

    <menuitem id="unicah_equipo_menu"
              name="Equipos"
              parent="unicah_prestamo_root_menu"
              action="unicah_equipo_action"
              sequence="20"/>
</odoo>
