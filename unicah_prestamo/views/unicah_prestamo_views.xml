<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="unicah_prestamo_view_list" model="ir.ui.view">
        <field name="name">unicah.prestamo.list</field>
        <field name="model">unicah.prestamo</field>
        <field name="arch" type="xml">
            <list decoration-info="estado == 'borrador'"
                  decoration-success="estado == 'devuelto'">
                <field name="name"/>
                <field name="solicitante_id"/>
                <field name="equipo_id"/>
                <field name="fecha_prestamo"/>
                <field name="fecha_devolucion"/>
                <field name="dias" sum="Total de días"/>
                <field name="estado" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="unicah_prestamo_view_form" model="ir.ui.view">
        <field name="name">unicah.prestamo.form</field>
        <field name="model">unicah.prestamo</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_prestar" string="Entregar equipo"
                            type="object" invisible="estado != 'borrador'" class="btn-primary"/>
                    <button name="action_devolver" string="Registrar devolución"
                            type="object" invisible="estado != 'prestado'"/>
                    <field name="estado" widget="statusbar" statusbar_visible="borrador,prestado,devuelto"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="solicitante_id"/>
                            <field name="equipo_id"/>
                        </group>
                        <group>
                            <field name="fecha_prestamo"/>
                            <field name="fecha_devolucion"/>
                            <field name="dias"/>
                            <field name="estado"/>
                        </group>
                    </group>
                    <group>
                        <field name="observaciones"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="unicah_prestamo_action" model="ir.actions.act_window">
        <field name="name">Préstamos</field>
        <field name="res_model">unicah.prestamo</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="unicah_prestamo_menu"
              name="Préstamos"
              parent="unicah_prestamo_root_menu"
              action="unicah_prestamo_action"
              sequence="10"/>
</odoo>
